{%- comment -%}
  Plumbing snippet for storefront password authentication form.
{%- endcomment -%}
{%- form 'storefront_password', class: 'password-form' -%}
  <label for="password" class="visually-hidden">
    {{- 'general.password_page.password_label' | t -}}
  </label>
  <div class="newsletter-form__field">
    <input
      type="password"
      name="password"
      id="password"
      class="newsletter-form__input"
      placeholder="{{ 'general.password_page.password_placeholder' | t }}"
      autocomplete="current-password"
      {% if form.errors %}
        aria-invalid="true"
      {% endif %}
      required
    >
    <button type="submit" class="button button--primary">
      {{ 'general.password_page.submit' | t }}
    </button>
  </div>
  {%- if form.errors -%}
    <p class="password-form__error" role="alert">{{ form.errors.messages.form }}</p>
  {%- endif -%}
{%- endform -%}

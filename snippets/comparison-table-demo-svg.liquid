{%- comment -%}
  Comparison Table Demo Product SVG Illustrations
  Provides high-fidelity skincare product renders matching agent-image/from-tinker/comparision-table/image.png
  Variants:
  - 'serum'  : Amber glass dropper bottle (Argan Milk Serum)
  - 'jar'    : Golden amber cosmetic cream jar (Whipped Argan Oil Body Butter)
  - 'oil'    : Frosted aesthetic cosmetic bottle with pump (Beautifying Oil Face)
  - 'dropper': Tall tinted dropper bottle
  - 'tube'   : Minimalist skincare treatment tube
{%- endcomment -%}

{%- case variant -%}
  {%- when 'serum' -%}
    <svg
      class="comparison-table__demo-svg"
      viewBox="0 0 160 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Argan Milk Serum Bottle"
      preserveAspectRatio="xMidYMid meet"
      style="width:100%;height:100%;max-height:120px;display:block;margin:0 auto;"
    >
      <defs>
        <linearGradient id="serum-glass" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#C27D38"/>
          <stop offset="35%" stop-color="#E89B48"/>
          <stop offset="70%" stop-color="#A55A1A"/>
          <stop offset="100%" stop-color="#6E380D"/>
        </linearGradient>
        <linearGradient id="serum-cap" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#805433"/>
          <stop offset="50%" stop-color="#BD8557"/>
          <stop offset="100%" stop-color="#6B3F1E"/>
        </linearGradient>
        <radialGradient id="serum-bulb" cx="40%" cy="35%" r="60%">
          <stop offset="0%" stop-color="#FFFFFF"/>
          <stop offset="70%" stop-color="#E0DFDC"/>
          <stop offset="100%" stop-color="#B8B6B2"/>
        </radialGradient>
        <filter id="serum-shadow" x="-30%" y="-10%" width="160%" height="130%">
          <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#40230C" flood-opacity="0.22"/>
        </filter>
      </defs>

      <!-- Contact ground shadow -->
      <ellipse cx="80" cy="188" rx="36" ry="6" fill="#2B1A0E" opacity="0.18"/>

      <g filter="url(#serum-shadow)">
        <!-- White rubber dropper bulb -->
        <path d="M72,32 C72,20 75,12 80,12 C85,12 88,20 88,32 Z" fill="url(#serum-bulb)"/>
        <!-- Collar ring -->
        <rect x="70" y="32" width="20" height="6" rx="2" fill="#E6E6E6"/>

        <!-- Neck cap collar -->
        <rect x="68" y="38" width="24" height="24" rx="2" fill="url(#serum-cap)"/>
        <line x1="68" y1="44" x2="92" y2="44" stroke="#5E381A" stroke-width="1"/>
        <line x1="68" y1="52" x2="92" y2="52" stroke="#5E381A" stroke-width="1"/>

        <!-- Amber glass body with curved shoulders -->
        <path d="M68,62 C68,76 48,96 48,128 C48,162 60,184 80,184 C100,184 112,162 112,128 C112,96 92,76 92,62 Z" fill="url(#serum-glass)"/>

        <!-- Inner liquid refraction highlight -->
        <path d="M54,124 C54,154 64,176 80,176 C96,176 106,154 106,124 C106,102 96,86 88,72 C72,86 54,102 54,124 Z" fill="#FCAE53" opacity="0.35"/>

        <!-- Glass reflection gleam line -->
        <path d="M55,108 C53,124 55,152 64,170" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.5" fill="none"/>

        <!-- Label label plaque -->
        <rect x="60" y="120" width="40" height="26" rx="3" fill="#FFEEDB" opacity="0.85"/>
        <line x1="66" y1="128" x2="94" y2="128" stroke="#683A14" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="70" y1="134" x2="90" y2="134" stroke="#885226" stroke-width="1" stroke-linecap="round"/>
        <line x1="72" y1="139" x2="88" y2="139" stroke="#885226" stroke-width="1" stroke-linecap="round"/>
      </g>
    </svg>

  {%- when 'jar' -%}
    <svg
      class="comparison-table__demo-svg"
      viewBox="0 0 160 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Whipped Argan Body Butter Jar"
      preserveAspectRatio="xMidYMid meet"
      style="width:100%;height:100%;max-height:120px;display:block;margin:0 auto;"
    >
      <defs>
        <linearGradient id="jar-body" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#DF9C4D"/>
          <stop offset="40%" stop-color="#F2BE78"/>
          <stop offset="80%" stop-color="#BD762A"/>
          <stop offset="100%" stop-color="#8E5215"/>
        </linearGradient>
        <linearGradient id="jar-lid" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#734B22"/>
          <stop offset="50%" stop-color="#A6733E"/>
          <stop offset="100%" stop-color="#543313"/>
        </linearGradient>
        <filter id="jar-shadow" x="-20%" y="-10%" width="140%" height="130%">
          <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#40230C" flood-opacity="0.22"/>
        </filter>
      </defs>

      <!-- Shadow -->
      <ellipse cx="80" cy="186" rx="55" ry="7" fill="#2B1A0E" opacity="0.18"/>

      <g filter="url(#jar-shadow)">
        <!-- Top Lid -->
        <rect x="32" y="100" width="96" height="18" rx="5" fill="url(#jar-lid)"/>
        <!-- Lid gleam -->
        <line x1="38" y1="104" x2="122" y2="104" stroke="#D8A56D" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>

        <!-- Glass Jar Bottom Tub -->
        <rect x="30" y="118" width="100" height="64" rx="12" fill="url(#jar-body)"/>

        <!-- Cream reflection inside -->
        <rect x="36" y="124" width="88" height="50" rx="8" fill="#FFF2DC" opacity="0.2"/>

        <!-- Glass wall highlight left -->
        <path d="M36,128 L36,170" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.5"/>

        <!-- Minimal label strip -->
        <rect x="46" y="138" width="68" height="24" rx="3" fill="#FFF6EB" opacity="0.75"/>
        <line x1="56" y1="146" x2="104" y2="146" stroke="#683A14" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="62" y1="152" x2="98" y2="152" stroke="#885226" stroke-width="1" stroke-linecap="round"/>
      </g>
    </svg>

  {%- when 'oil' -%}
    <svg
      class="comparison-table__demo-svg"
      viewBox="0 0 160 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Beautifying Face Oil Bottle"
      preserveAspectRatio="xMidYMid meet"
      style="width:100%;height:100%;max-height:120px;display:block;margin:0 auto;"
    >
      <defs>
        <linearGradient id="oil-glass" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#FFFFFF"/>
          <stop offset="25%" stop-color="#F7EDE3"/>
          <stop offset="70%" stop-color="#EAD5C2"/>
          <stop offset="100%" stop-color="#D6B89E"/>
        </linearGradient>
        <linearGradient id="rose-gold-cap" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#C59B89"/>
          <stop offset="50%" stop-color="#E8C3B3"/>
          <stop offset="100%" stop-color="#B28470"/>
        </linearGradient>
        <filter id="oil-shadow" x="-25%" y="-10%" width="150%" height="130%">
          <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#473121" flood-opacity="0.18"/>
        </filter>
      </defs>

      <!-- Shadow -->
      <ellipse cx="80" cy="188" rx="32" ry="6" fill="#3B2618" opacity="0.15"/>

      <g filter="url(#oil-shadow)">
        <!-- Metallic rose gold cap -->
        <rect x="65" y="44" width="30" height="42" rx="3" fill="url(#rose-gold-cap)"/>
        <line x1="67" y1="52" x2="93" y2="52" stroke="#FFFFFF" stroke-width="1" opacity="0.5"/>

        <!-- Neck band -->
        <rect x="63" y="86" width="34" height="4" rx="1" fill="#DFC0B0"/>

        <!-- Frosted sleek cylinder bottle -->
        <rect x="55" y="90" width="50" height="94" rx="12" fill="url(#oil-glass)"/>

        <!-- Soft inner golden oil glow -->
        <rect x="60" y="102" width="40" height="74" rx="8" fill="#FCE4CA" opacity="0.45"/>

        <!-- Frosted glass vertical highlight -->
        <line x1="61" y1="102" x2="61" y2="172" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.6"/>

        <!-- Delicate subtle title text lines -->
        <line x1="68" y1="136" x2="92" y2="136" stroke="#9A7761" stroke-width="1.2" stroke-linecap="round"/>
        <line x1="72" y1="142" x2="88" y2="142" stroke="#B08D77" stroke-width="0.9" stroke-linecap="round"/>
      </g>
    </svg>

  {%- when 'dropper' -%}
    <svg
      class="comparison-table__demo-svg"
      viewBox="0 0 160 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Skincare Dropper Bottle"
      preserveAspectRatio="xMidYMid meet"
      style="width:100%;height:100%;max-height:120px;display:block;margin:0 auto;"
    >
      <defs>
        <linearGradient id="dropper-glass" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#E8ECE9"/>
          <stop offset="50%" stop-color="#CFDCD3"/>
          <stop offset="100%" stop-color="#A5BCAE"/>
        </linearGradient>
        <filter id="dropper-shadow" x="-25%" y="-10%" width="150%" height="130%">
          <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#21382A" flood-opacity="0.18"/>
        </filter>
      </defs>
      <ellipse cx="80" cy="188" rx="30" ry="6" fill="#15261C" opacity="0.15"/>
      <g filter="url(#dropper-shadow)">
        <path d="M72,28 C72,16 76,10 80,10 C84,10 88,16 88,28 Z" fill="#2E3A33"/>
        <rect x="68" y="28" width="24" height="26" rx="2" fill="#1C2420"/>
        <rect x="56" y="54" width="48" height="130" rx="14" fill="url(#dropper-glass)"/>
        <line x1="62" y1="64" x2="62" y2="170" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" opacity="0.6"/>
      </g>
    </svg>

  {%- else -%}
    <svg
      class="comparison-table__demo-svg"
      viewBox="0 0 160 200"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-label="Skincare Product Tube"
      preserveAspectRatio="xMidYMid meet"
      style="width:100%;height:100%;max-height:120px;display:block;margin:0 auto;"
    >
      <defs>
        <linearGradient id="tube-grad" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#EFEFEF"/>
          <stop offset="50%" stop-color="#FFFFFF"/>
          <stop offset="100%" stop-color="#E0E0E0"/>
        </linearGradient>
        <filter id="tube-shadow" x="-25%" y="-10%" width="150%" height="130%">
          <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#2E2E2E" flood-opacity="0.16"/>
        </filter>
      </defs>
      <ellipse cx="80" cy="188" rx="28" ry="6" fill="#222222" opacity="0.15"/>
      <g filter="url(#tube-shadow)">
        <!-- Top crimp -->
        <rect x="56" y="24" width="48" height="8" rx="1" fill="#C5C5C5"/>
        <!-- Tube body -->
        <path d="M56,32 L60,154 L100,154 L104,32 Z" fill="url(#tube-grad)"/>
        <!-- Flip cap -->
        <rect x="64" y="154" width="32" height="30" rx="4" fill="#333333"/>
        <line x1="66" y1="46" x2="66" y2="140" stroke="#FFFFFF" stroke-width="2.5" opacity="0.6"/>
      </g>
    </svg>
{%- endcase -%}

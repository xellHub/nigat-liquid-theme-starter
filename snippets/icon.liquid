{%- comment -%}
  Renders an inline SVG icon.

  Accepts:
  - name: {String} icon name (required)
  - class: {String} extra CSS classes (optional)

  Usage:
  {% render 'icon', name: 'cart' %}
{%- endcomment -%}

{%- liquid
  assign icon_class = 'icon icon-' | append: name
  if class
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}


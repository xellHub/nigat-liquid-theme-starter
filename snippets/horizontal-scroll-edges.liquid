<div class="horizontal-scroll-edge horizontal-scroll-edge--left">
  <button type="button" class="horizontal-scroll-arrow" data-scroll-previous aria-label="Scroll {{ label }} left" disabled>
    {% render 'icon', name: 'arrow-left' %}
  </button>
</div>
<div class="horizontal-scroll-edge horizontal-scroll-edge--right">
  <button type="button" class="horizontal-scroll-arrow" data-scroll-next aria-label="Scroll {{ label }} right" disabled>
    {% render 'icon', name: 'arrow-right' %}
  </button>
</div>

{%- comment -%}
  Editorial photography demo images for Collection List Material Cards.
  Uses high-resolution beauty & accessories portrait photography.

  Accepts:
  - item_index: 1..3
  - card_title: String (optional)
{%- endcomment -%}

{%- liquid
  assign idx = item_index | default: 1 | plus: 0
  if idx < 1 or idx > 3
    assign idx = 1
  endif
  assign asset_name = 'material-card-beauty-' | append: idx | append: '.jpg'
-%}

<img
  src="{{ asset_name | asset_url }}"
  alt=""
  class="material-collection-card__image"
  loading="lazy"
  width="800"
  height="1000"
>

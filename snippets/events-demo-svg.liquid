          <ellipse cx="14" cy="18" rx="13" ry="9" fill="#261220" transform="rotate(-35)"/>
          <!-- Rosemary sprig -->
          <path d="M-15,30 Q20,10 60,-5" stroke="#48633B" stroke-width="3" fill="none"/>
          <path d="M0,22 L-8,14 M12,16 L8,6 M26,11 L32,0 M40,6 L48,-6" stroke="#688C56" stroke-width="2.5" stroke-linecap="round"/>

        <!-- Shoulder -->
        <path d="M25,60 C10,95 0,130 0,165 L74,165 C74,130 64,95 49,60 Z" fill="url(#bottle-glass)"/>
        <!-- Body -->
        <rect x="0" y="165" width="74" height="230" rx="4" fill="url(#bottle-glass)"/>
        <!-- Minimalist craft label -->
        <rect x="4" y="210" width="66" height="110" rx="2" fill="#FBF8F2"/>
        <rect x="14" y="235" width="46" height="3" fill="#261220"/>
        <rect x="20" y="246" width="34" height="2" fill="#886483"/>
        <rect x="26" y="280" width="22" height="20" rx="10" fill="#C2255C" opacity="0.85"/>
      </g>

      <!-- Wine glass with natural wine in foreground -->
      <g transform="translate(190, 110)" filter="url(#glass-shadow)">
        <!-- Base of glass -->
        <ellipse cx="60" cy="360" rx="44" ry="10" fill="#FFFFFF" opacity="0.25"/>
        <ellipse cx="60" cy="360" rx="40" ry="7" fill="#FFFFFF" opacity="0.4"/>
        <!-- Stem -->
        <rect x="58" y="220" width="4" height="140" fill="#FFFFFF" opacity="0.5"/>
        <!-- Bowl -->
        <path d="M10,70 C5,160 30,225 60,225 C90,225 115,160 110,70 Z" fill="#FFFFFF" opacity="0.12" stroke="#FFFFFF" stroke-width="1.5"/>
        <!-- Wine inside bowl -->
        <path d="M16,130 C12,175 32,218 60,218 C88,218 108,175 104,130 C90,138 30,138 16,130 Z" fill="url(#wine-ruby)"/>
        <!-- Wine surface ellipse -->
        <ellipse cx="60" cy="132" rx="44" ry="12" fill="#E64980" opacity="0.9"/>
        <ellipse cx="60" cy="132" rx="36" ry="8" fill="#9E123F"/>
        <!-- Glass rim highlight -->
        <ellipse cx="60" cy="70" rx="48" ry="10" stroke="#FFFFFF" stroke-width="1.5" fill="none" opacity="0.6"/>
        <!-- Vertical reflection on bowl -->
        <path d="M22,90 C18,130 25,170 38,195" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.45"/>
      </g>
    </svg>


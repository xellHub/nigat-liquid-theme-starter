      <!-- Heritage wine bottle on left -->
      <g transform="translate(90, 80)" filter="url(#glass-shadow)">
        <rect x="25" y="0" width="24" height="60" rx="3" fill="url(#bottle-glass)"/>
        <!-- Capsule foil -->

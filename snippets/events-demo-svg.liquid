        <!-- Artisanal crackers -->
        <rect x="200" y="100" width="45" height="45" rx="5" fill="#DEB887" transform="rotate(15 200 100)"/>
        <circle cx="215" cy="115" r="1.5" fill="#9C6B37"/>
        <circle cx="230" cy="120" r="1.5" fill="#9C6B37"/>
        <circle cx="220" cy="130" r="1.5" fill="#9C6B37"/>

{%- comment -%}
  Section Background & Framing Component — Unified reusable background handler across all theme sections.
  Supports both section settings and dedicated 'background' blocks.
  Usage:
    {% render 'section-background',
      section_id: section.id,
      block: block,
      background_color: section.settings.background_color,
      background_gradient: section.settings.background_gradient,
      background_image: section.settings.background_image,
      overlay_opacity: section.settings.background_overlay_opacity,
      padding_top: section.settings.padding_top,
      padding_bottom: section.settings.padding_bottom
    %}
{%- endcomment -%}

{%- liquid
  assign sec_id = section_id | default: section.id
  assign pt = padding_top | default: target.settings.padding_top
  assign pb = padding_bottom | default: target.settings.padding_bottom
  assign bg_img = background_image | default: target.settings.background_image
  assign overlay = overlay_opacity | default: target.settings.background_overlay_opacity | default: target.settings.overlay_opacity | default: 0
  assign bg_color = background_color | default: target.settings.background_color
  assign bg_gradient = background_gradient | default: target.settings.background_gradient
-%}

{%- style -%}
  #shopify-section-{{ sec_id }},
  #{{ sec_id }},
  .section-id-{{ sec_id }} {
    position: relative;
    --padding-top: {% if pt != blank and pt == 0 %}0px{% else %}var(--spacing-sections){% endif %};
    --padding-bottom: {% if pb != blank and pb == 0 %}0px{% else %}var(--spacing-sections){% endif %};
    {%- if bg_color != blank and bg_color != 'rgba(0,0,0,0)' and bg_color != 'transparent' -%}
      --color-background: {{ bg_color }};
      background-color: {{ bg_color }};
    {%- endif -%}
    {%- if bg_gradient != blank -%}
      --color-background-gradient: {{ bg_gradient }};
      background-image: {{ bg_gradient }};
    {%- endif -%}
    --section-overlay-opacity: {{ overlay | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- if bg_img != blank -%}
  <div class="section-background-media" aria-hidden="true">
    {{
      bg_img
      | image_url: width: 2800
      | image_tag:
        loading: 'lazy',
        widths: '750, 1100, 1500, 2000, 2800',
        sizes: '100vw',
        class: 'section-background-media__image'
    }}
    {%- if overlay > 0 -%}
      <div class="section-background-media__overlay"></div>
    {%- endif -%}
  </div>
{%- endif -%}

      "settings": {
        "color_scheme": "bare-light",
        "desktop_height": 840,
        "page_width": 1600,
        "padding_top": 0,
        "padding_bottom": 0,
        "initial_slide": 3,
        "autoplay": false,
        "autoplay_interval": 6

{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "content": {
          "type": "_page-content",
          "settings": {}
        }
      },
      "block_order": [
        "content"
      ],
      "settings": {
        "page_width": 800,
        "padding_top": 48,
        "padding_bottom": 64
      }
    },
    "guide": {
      "type": "size-guide",
      "settings": {},
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Sizing & Measurements",
            "level": "h2",
            "size": "large",
            "alignment": "center"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Compare your body measurements against our size charts below to choose your ideal fit.</p>",
            "alignment": "center",
            "color_role": "muted"
          }
        },
        "content": {
          "type": "_size-guide-content",
          "settings": {
            "show_unit_switcher": true
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "content"
      ]
    },
    "featured": {
      "type": "featured-collection",
      "settings": {
        "page_width": 1360,
        "padding_top": 56,
        "padding_bottom": 56
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Shop Popular Sizes",
            "level": "h2",
            "size": "large",
            "alignment": "center"
          }
        },
        "tabs": {
          "type": "_collection-tabs",
          "settings": {
            "active_tab": 1,
            "products_to_show": 4,
            "columns_desktop": 4
          },
          "blocks": {
            "product-card": {
              "type": "product-card",
              "static": true,
              "settings": {
                "product": "{{ closest.product }}"
              },
              "blocks": {
                "image": {
                  "type": "image",
                  "settings": {
                    "image": "{{ closest.product.featured_image }}",
                    "link": "{{ closest.product.url }}",
                    "alt": "{{ closest.product.title }}"
                  }
                },
                "sale-badge": {
                  "type": "badge",
                  "settings": {
                    "product": "{{ closest.product }}",
                    "mode": "sale"
                  }
                },
                "title": {
                  "type": "heading",
                  "settings": {
                    "text": "{{ closest.product.title }}",
                    "level": "h3",
                    "size": "small"
                  }
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                },
                "rating": {
                  "type": "rating",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                },
                "view-product": {
                  "type": "button",
                  "settings": {
                    "label": "View product",
                    "style": "link",
                    "link": "{{ closest.product.url }}"
                  }
                },
                "vendor": {
                  "type": "eyebrow",
                  "settings": {
                    "text": "{{ closest.product.vendor }}",
                    "color_role": "muted"
                  }
                },
                "swatches": {
                  "type": "product-swatches",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                }
              },
              "block_order": [
                "image",
                "sale-badge",
                "vendor",
                "title",
                "price",
                "rating",
                "swatches",
                "view-product"
              ]
            }
          }
        },
        "view-all": {
          "type": "link",
          "settings": {
            "label": "View all",
            "link": "/collections",
            "icon": "arrow-right"
          }
        }
      },
      "block_order": [
        "heading",
        "view-all",
        "tabs"
      ]
    }
  },
  "order": [
    "main",
    "guide",
    "featured"
  ]
}

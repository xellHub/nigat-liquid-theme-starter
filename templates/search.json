{
  "sections": {
    "main": {
      "type": "main-search",
      "settings": {
        "page_width": 1400,
        "padding_top": 48,
        "padding_bottom": 64
      },
      "blocks": {
        "content": {
          "type": "_catalog-results",
          "settings": {
            "mode": "search",
            "items_per_page": 12,
            "columns_desktop": 4,
            "enable_sorting": true,
            "enable_filtering": true
          },
          "blocks": {
            "product-card": {
              "type": "product-card",
              "static": true,
              "settings": {
                "product": "{{ closest.product }}"
              },
              "blocks": {
                "image": {
                  "type": "image",
                  "settings": {
                    "image": "{{ closest.product.featured_image }}",
                    "link": "{{ closest.product.url }}",
                    "alt": "{{ closest.product.title }}"
                  }
                },
                "sale-badge": {
                  "type": "badge",
                  "settings": {
                    "product": "{{ closest.product }}",
                    "mode": "sale"
                  }
                },
                "title": {
                  "type": "heading",
                  "settings": {
                    "text": "{{ closest.product.title }}",
                    "level": "h3",
                    "size": "small"
                  }
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                },
                "rating": {
                  "type": "rating",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                },
                "view-product": {
                  "type": "button",
                  "settings": {
                    "label": "View product",
                    "style": "link",
                    "link": "{{ closest.product.url }}"
                  }
                }
              },
              "block_order": [
                "image",
                "sale-badge",
                "title",
                "price",
                "rating",
                "view-product"
              ]
            }
          }
        }
      },
      "block_order": [
        "content"
      ]
    }
  },
  "order": [
    "main"
  ]
}

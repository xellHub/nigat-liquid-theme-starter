{
  "sections": {
    "main": {
      "type": "main-404",
      "settings": {},
      "blocks": {
        "content": {
          "type": "_main-404-content",
          "settings": {
            "padding_top": 60,
            "padding_bottom": 48
          },
          "blocks": {
            "title": {
              "type": "heading",
              "settings": {
                "text": "Lost in space? Page not found.",
                "level": "h1",
                "size": "large",
                "alignment": "center"
              }
            },
            "subtext": {
              "type": "text",
              "settings": {
                "text": "<p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>",
                "alignment": "center",
                "color_role": "muted"
              }
            },
            "button": {
              "type": "button",
              "settings": {
                "label": "Explore all products",
                "link": "/collections/all",
                "style": "primary"
              }
            }
          },
          "block_order": [
            "title",
            "subtext",
            "button"
          ]
        }
      },
      "block_order": [
        "content"
      ]
    },
    "featured": {
      "type": "featured-collection",
      "settings": {
        "page_width": 1360,
        "padding_top": 40,
        "padding_bottom": 64
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Popular Bestsellers",
            "level": "h2",
            "size": "large",
            "alignment": "center"
          }
        },
        "tabs": {
          "type": "_collection-tabs",
          "settings": {
            "active_tab": 1,
            "products_to_show": 4,
            "columns_desktop": 4
          },
          "blocks": {
            "product-card": {
              "type": "product-card",
              "static": true,
              "settings": {
                "product": "{{ closest.product }}"
              },
              "blocks": {
                "image": {
                  "type": "image",
                  "settings": {
                    "image": "{{ closest.product.featured_image }}",
                    "link": "{{ closest.product.url }}",
                    "alt": "{{ closest.product.title }}"
                  }
                },
                "sale-badge": {
                  "type": "badge",
                  "settings": {
                    "product": "{{ closest.product }}",
                    "mode": "sale"
                  }
                },
                "title": {
                  "type": "heading",
                  "settings": {
                    "text": "{{ closest.product.title }}",
                    "level": "h3",
                    "size": "small"
                  }
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                },
                "rating": {
                  "type": "rating",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                },
                "view-product": {
                  "type": "button",
                  "settings": {
                    "label": "View product",
                    "style": "link",
                    "link": "{{ closest.product.url }}"
                  }
                },
                "vendor": {
                  "type": "eyebrow",
                  "settings": {
                    "text": "{{ closest.product.vendor }}",
                    "color_role": "muted"
                  }
                },
                "swatches": {
                  "type": "product-swatches",
                  "settings": {
                    "product": "{{ closest.product }}"
                  }
                }
              },
              "block_order": [
                "image",
                "sale-badge",
                "vendor",
                "title",
                "price",
                "rating",
                "swatches",
                "view-product"
              ]
            }
          }
        },
        "view-all": {
          "type": "link",
          "settings": {
            "label": "View all",
            "link": "/collections",
            "icon": "arrow-right"
          }
        }
      },
      "block_order": [
        "heading",
        "view-all",
        "tabs"
      ]
    }
  },
  "order": [
    "main",
    "featured"
  ]
}

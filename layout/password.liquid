<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta
      name="theme-color"
      content="{{ settings.palette_5_light.settings.background | default: '#ffffff' }}"
    >
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    <title>
      {{ page_title }}
      &ndash;
      {{ shop.name }}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
    -%}

    {% style %}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      :root {
        --color-background: {{ settings.palette_5_light.settings.background }};
        --color-surface: {{ settings.palette_5_light.settings.surface }};
        --color-surface-raised: {{ settings.palette_5_light.settings.surface_raised }};
        --color-text: {{ settings.palette_5_light.settings.text }};
        --color-accent: {{ settings.palette_5_light.settings.accent }};
        --color-accent-text: {{ settings.palette_5_light.settings.accent_foreground }};
        --color-button: {{ settings.palette_5_light.settings.button }};
        --color-button-text: {{ settings.palette_5_light.settings.button_label }};
        --color-border: {{ settings.palette_5_light.settings.border }};
        --color-muted: {{ settings.palette_5_light.settings.muted }};
        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-weight: {{ body_font.weight }};
        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-weight: {{ heading_font.weight }};
        --font-accent-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-accent-weight: {{ heading_font.weight }};
        --font-button-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-button-weight: 600;
        --font-body-scale: 1;
        --font-heading-scale: 1.1;
        --page-width: 128rem;
        --spacing-sections: 4.8rem;
        --corner-radius: {{ settings.corner_radius }}px;
        --radius-button: {{ settings.button_corner_radius }}px;
      }
    {% endstyle %}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace(
        'no-js',
        'js'
      );
    </script>
  </head>

  <body class="template-password">
    <main class="password-layout" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>

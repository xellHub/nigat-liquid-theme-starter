<section
  id="FeaturedBlog-{{ section.id }}"
  class="featured-blog-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
  style="--blog-width: {{ section.settings.page_width }}px; --blog-pt: {{ section.settings.padding_top }}px; --blog-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="featured-blog-layout__inner">{% content_for 'blocks' %}</div>
</section>

{% stylesheet %}
  .featured-blog-layout {
    padding-block: var(--blog-pt) var(--blog-pb);
    color: var(--color-text);
    background: var(--color-background);
    container-type: inline-size;
  }
  .featured-blog-layout__inner {
    display: flex;
    width: min(calc(100% - (2 * var(--foundation-gutter-mobile))), var(--blog-width));
    margin-inline: auto;
    flex-direction: column;
    gap: var(--space-5);
  }
  .featured-blog-layout__inner > .theme-group--row {
    align-items: center;
    justify-content: space-between;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "class": "featured-blog-section",
  "blocks": [
    { "type": "heading" },
    { "type": "link" },
    { "type": "group" },
    { "type": "_blog-carousel" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1300
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Blog posts",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "direction": "row",
            "alignment": "center",
            "gap": "3"
          },
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "From the Journal",
                "level": "h2",
                "size": "small",
                "alignment": "left"
              }
            },
            {
              "type": "link",
              "settings": {
                "label": "View all",
                "icon": "arrow-right"
              }
            }
          ]
        },
        {
          "type": "_blog-carousel"
        }
      ],
      "category": "Storytelling"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

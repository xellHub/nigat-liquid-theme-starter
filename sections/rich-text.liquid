<section
  id="RichText-{{ section.id }}"
  class="rich-text-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
  style="--layout-padding-top: {{ section.settings.padding_top }}px; --layout-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="rich-text-layout__inner rich-text-layout__inner--{{ section.settings.alignment }}">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .rich-text-layout {
    padding-block: var(--layout-padding-top) var(--layout-padding-bottom);
    color: var(--color-text);
    background: var(--color-background);
  }
  .rich-text-layout__inner {
    display: flex;
    width: min(
      calc(100% - (2 * var(--foundation-gutter-mobile))),
      var(--foundation-content-width-narrow)
    );
    flex-direction: column;
    gap: var(--space-4);
    margin-inline: auto;
  }
  .rich-text-layout__inner--center {
    align-items: center;
    text-align: center;
  }
  .rich-text-layout__inner--left {
    align-items: flex-start;
    text-align: left;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "rich-text-section",
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "eyebrow" },
    { "type": "button" },
    { "type": "group" },
    { "type": "quote" },
    { "type": "spacer" },
    { "type": "divider" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "category": "Text & Editorial",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Talk about your brand",
            "alignment": "center"
          }
        },
        {
          "type": "text",
          "settings": {
            "alignment": "center"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

<section
  id="IconsWithText-{{ section.id }}"
  class="icon-grid-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
  style="--layout-padding-top: {{ section.settings.padding_top }}px; --layout-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="icon-grid-layout__inner">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .icon-grid-layout {
    padding-block: var(--layout-padding-top) var(--layout-padding-bottom);
    color: var(--color-text);
    background: var(--color-background);
    container-type: inline-size;
  }
  .icon-grid-layout__inner {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}

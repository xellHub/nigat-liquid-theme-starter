                {
                  "type": "badge",
                  "settings": {
                    "label": "Gather beautifully",
                    "style": "on-media"
                  }
                },
                {
                  "type": "heading",
                  "settings": {
                    "text": "Made for the moments between",
                    "level": "h1",
                    "size": "display",
                    "color_role": "on_media",
                    "max_width": 18
                  }
                },
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Timeless forms bring calm structure to the rooms where conversations take their time.</p>",
                    "size": "large",
                    "color_role": "on_media",
                    "max_width": 48
                  }
                },
                {
                  "type": "button",
                  "settings": {
                    "label": "Explore collection",
                    "style": "outline",
                    "icon": "arrow-right"
                  }
                }
              ]
            },
            {
              "type": "_hero-slide",
              "settings": {
                "content_position": "end"
              },
              "blocks": [
                {
                  "type": "badge",
                  "settings": {
                    "label": "Architectural seating",
                    "style": "on-media"
                  }
                },
                {
                  "type": "heading",
                  "settings": {
                    "text": "Precision lines, enduring comfort",
                    "level": "h2",
                    "size": "display",
                    "color_role": "on_media",
                    "max_width": 18
                  }
                },
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Elevated proportions meet thoughtful materials for contemporary living spaces.</p>",
                    "size": "large",
                    "color_role": "on_media",
                    "max_width": 48
                  }
                },
                {
                  "type": "button",
                  "settings": {
                    "label": "Shop seating",
                    "style": "outline"
                  }
                }
              ]
            },
            {
              "type": "_hero-slide",
              "blocks": [
                {
                  "type": "badge",
                  "settings": {
                    "label": "Living icons",
                    "style": "on-media"
                  }
                },
                {
                  "type": "heading",
                  "settings": {
                    "text": "Designed to stay in memory",
                    "level": "h2",
                    "size": "display",
                    "color_role": "on_media",
                    "max_width": 18
                  }
                },
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Every seam and curve is shaped by mindful material selection and lasting craft.</p>",
                    "size": "large",
                    "color_role": "on_media",
                    "max_width": 48
                  }
                }
              ]
            }
          ]
        }
      ],
      "category": "Banners & Heroes"
    },
    {
      "name": "Hero — gradient media",
      "settings": {
        "max_width": "full"
      },
      "blocks": [
        {
          "type": "_hero-media",
          "settings": {
            "media_side": "right",
            "scrim_tone": "dark",
            "height": "medium"
          },
          "blocks": [
            {
              "type": "badge",
              "settings": {
                "label": "New collection",
                "style": "on-media"
              }
            },
            {
              "type": "heading",
              "settings": {
                "text": "Designed to last, made to love",

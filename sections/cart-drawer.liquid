<section
  id="cart-drawer-{{ section.id }}"
  class="cart-drawer-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
>
  {% if section.blocks.size > 0 %}
    {% content_for 'blocks' %}
  {% else %}
    {% content_for 'block', type: '_cart-drawer-content', id: 'cart-drawer-content' %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart drawer",
  "tag": "section",
  "class": "cart-drawer-section",
  "blocks": [
    {
      "type": "_cart-drawer-content"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    }
  ]
}
{% endschema %}

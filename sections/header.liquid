<section
  id="header-{{ section.id }}"
  class="header-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
>
  {% content_for 'blocks' %}
</section>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "blocks": [
    {
      "type": "_header-content"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    }
  ]
}
{% endschema %}

<section
  id="main-collection-{{ section.id }}"
  class="main-collection-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
  style="--resource-width: {{ section.settings.page_width }}px; --resource-pt: {{ section.settings.padding_top }}px; --resource-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="main-collection-layout__inner">{% content_for 'blocks' %}</div>
</section>
{% stylesheet %}
  .main-collection-layout {
    padding-block: var(--resource-pt) var(--resource-pb);
    color: var(--color-text);
    background: var(--color-background);
    container-type: inline-size;
  }
  .main-collection-layout__inner {
    width: min(calc(100% - (2 * var(--foundation-gutter-mobile))), var(--resource-width));
    margin-inline: auto;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "main-collection-wrapper",
  "blocks": [{ "type": "_collection-banner" }, { "type": "_collection-navigation" }, { "type": "_catalog-results" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Content width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ]
}
{% endschema %}

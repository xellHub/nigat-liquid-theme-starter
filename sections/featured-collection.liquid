<section
  id="FeaturedCollection-{{ section.id }}"
  class="featured-collection-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
  style="--featured-width: {{ section.settings.page_width }}px; --featured-pt: {{ section.settings.padding_top }}px; --featured-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="featured-collection-layout__inner">{% content_for 'blocks' %}</div>
</section>
{% stylesheet %}
  .featured-collection-layout {
    padding-block: var(--featured-pt) var(--featured-pb);
    color: var(--color-text);
    background: var(--color-background);
    container-type: inline-size;
  }
  .featured-collection-layout__inner {
    display: flex;
    width: min(calc(100% - (2 * var(--foundation-gutter-mobile))), var(--featured-width));
    margin-inline: auto;
    flex-direction: column;
    gap: var(--space-5);
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "featured-collection-section",
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "_collection-tabs" },
    { "type": "button" },
    { "type": "link" },
    { "type": "group" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Content width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1360
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Featured collection tabs",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Featured collection",
            "level": "h2",
            "size": "inherit",
            "alignment": "center"
          }
        },
        {
          "type": "_collection-tabs",
          "settings": {
            "active_tab": 2,
            "products_to_show": 6,
            "columns_desktop": 4
          }
        }
      ],
      "category": "Products"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

{
  "plugins": ["@shopify/prettier-plugin-liquid"],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": "*.liquid",
      "options": {
        "parser": "liquid-html",
        "singleQuote": false
      }
    }
  ]
}

<section
  id="collection-material-{{ section.id }}"
  class="collection-material-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
  style="--layout-width:{{ section.settings.page_width }}px;--layout-pt:{{ section.settings.padding_top }}px;--layout-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="collection-material-layout__inner">{% content_for 'blocks' %}</div>
</section>

{% stylesheet %}
  .collection-material-layout {
    padding-block: var(--layout-pt) var(--layout-pb);
    color: var(--color-text);
    background: var(--color-background);
    container-type: inline-size;
    overflow-x: clip;
  }
  .collection-material-layout__inner {
    display: flex;
    width: min(calc(100% - 2 * var(--foundation-gutter-mobile)), var(--layout-width));
    margin: auto;
    flex-direction: column;
    gap: var(--space-5);
  }
  .collection-material-layout .theme-carousel {
    position: relative;
    width: auto;
    min-width: 0;
    margin-inline-start: 0;
    margin-inline-end: calc(
      -1 * max(var(--foundation-gutter-mobile, 2rem), calc((100vw - var(--layout-width)) / 2))
    );
    margin-inline-end: calc(
      -1 * max(var(--foundation-gutter-mobile, 2rem), calc((100cqw - var(--layout-width)) / 2))
    );
    overflow: visible;
  }
  .collection-material-layout .theme-carousel__viewport {
    overflow: visible;
  }
  .collection-material-layout .theme-carousel__track {
    display: flex;
    flex-wrap: nowrap !important;
    gap: var(--grid-gap, var(--space-4));
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    margin-inline-start: 0;
    padding-inline-start: 0;
    margin-inline-end: 0;
    padding-inline-end: max(
      var(--foundation-gutter-mobile, 2rem),
      calc((100vw - var(--layout-width)) / 2)
    );
    padding-inline-end: max(
      var(--foundation-gutter-mobile, 2rem),
      calc((100cqw - var(--layout-width)) / 2)
    );
  }
  .collection-material-layout .theme-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .collection-material-layout .theme-carousel__track > .theme-gradient-card,
  .collection-material-layout .theme-carousel__track > .material-collection-card {
    flex: 0 0 clamp(32rem, 58vw, 68rem);
    min-width: clamp(30rem, 58vw, 68rem);
    scroll-snap-align: start;
  }
{% endstylesheet %}

{% schema %}

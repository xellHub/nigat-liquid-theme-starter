<section
  id="featured-product-{{ section.id }}"
  class="featured-product-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
>
  {% content_for 'blocks' %}
</section>

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "featured-product-section",
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "_featured-product-content" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    }
  ],
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Product of the month",
            "level": "h2",
            "size": "medium",
            "alignment": "center"
          }
        },
        {
          "type": "_featured-product-content",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "{{ closest.product.title }}",
                "level": "h2",
                "size": "medium"
              }
            },
            {
              "type": "price",
              "settings": {
                "product": "{{ closest.product }}"
              }
            }
          ]
        }
      ],
      "category": "Products"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}

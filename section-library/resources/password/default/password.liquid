<section
  id="main-password-{{ section.id }}"
  class="main-password-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
>
  {% if section.blocks.size > 0 %}
    {% content_for 'blocks' %}
  {% else %}
    {% content_for 'block', type: '_password-resource', id: 'password-resource' %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "class": "main-password-wrapper",
  "blocks": [
    {
      "type": "_password-resource"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    }
  ]
}
{% endschema %}

<section
  id="main-404-{{ section.id }}"
  class="main-404-layout section {% if section.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ section.settings.color_scheme.id }}{% endif %}"
>
  {% content_for 'blocks' %}
</section>

{% schema %}
{
  "name": "Main 404",
  "tag": "section",
  "class": "main-404-wrapper",
  "blocks": [
    {
      "type": "_main-404-content"
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    }
  ]
}
{% endschema %}

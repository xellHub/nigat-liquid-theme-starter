                  "settings": {
                    "text": "Tell your story",
                    "level": "h2"
                  }
                },
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Share what makes your brand distinctive.</p>"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "Image with text — image right",
      "blocks": [
        {
          "type": "media-text",
          "settings": {
            "media_position": "end"
          },
          "blocks": [
            {
              "type": "image"
            },
            {
              "type": "group",
              "blocks": [
                {
                  "type": "heading",
                  "settings": {
                    "text": "Tell your story",
                    "level": "h2"
                  }
                },
                {
                  "type": "text",
                  "settings": {
                    "text": "<p>Share what makes your brand distinctive.</p>"
                  }
                }
              ]
            }
          ]

<figure class="theme-image" {{ block.shopify_attributes }}>
  {% if block.settings.link != blank -%}
    <a class="theme-image__link" href="{{ block.settings.link }}">
  {%- endif %}
  {%- if block.settings.image != blank -%}
    {% render 'responsive-image',
      image: block.settings.image,
      class: 'theme-image__media',
      alt: block.settings.alt,
      loading: 'lazy'
    %}
  {%- else -%}
    {%- assign p_var = block.settings.placeholder_variant | default: 'image' -%}
    <div class="placeholder-image theme-image__media">
      {% render 'placeholder-image', variant: p_var %}
    </div>
  {%- endif -%}
  {% if block.settings.link != blank %}</a>{% endif %}
</figure>

{% stylesheet %}
  .theme-image {
    width: 100%;
    margin: 0;
    overflow: hidden;
    background: var(--color-surface);
  }
  .theme-image__link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .theme-image__media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    border-radius: inherit;
  }
  .theme-image .placeholder-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--color-surface);
  }
  .theme-image .placeholder-image svg {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alternative text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "placeholder_variant",
      "label": "Demo placeholder",
      "options": [
        { "value": "image", "label": "Default image" },
        { "value": "hero_1", "label": "Hero 1" },
        { "value": "hero_2", "label": "Hero 2" },
        { "value": "hero_3", "label": "Hero 3" },
        { "value": "lifestyle_1", "label": "Lifestyle 1" },
        { "value": "lifestyle_2", "label": "Lifestyle 2" }
      ],
      "default": "image"
    }
  ],
  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}

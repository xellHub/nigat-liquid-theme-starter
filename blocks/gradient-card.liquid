    {
      "type": "select",
      "id": "foundation_margin_bottom",
      "label": "Bottom margin",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "2", "label": "XS" },
        { "value": "4", "label": "Medium" },
        { "value": "6", "label": "Large" },
        { "value": "8", "label": "XL" }

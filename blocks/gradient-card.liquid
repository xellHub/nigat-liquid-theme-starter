      "type": "text",
      "id": "foundation_anchor_id",
      "label": "Anchor ID"
    }
  ],
  "presets": [
    {
      "name": "Gradient card",
      "blocks": [
        {
          "type": "group",
          "settings": {
            "direction": "column",
            "alignment": "start",
            "gap": "3"
          },
          "blocks": [
            {
              "type": "eyebrow",
              "settings": {

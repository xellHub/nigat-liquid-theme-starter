{% if block.settings.foundation_anchor_id != blank -%}
  <span
    id="{{ block.settings.foundation_anchor_id | handle }}"
    class="foundation-block-anchor"
    aria-hidden="true"
  ></span>
{%- endif %}
<div
  class="{{ block.settings.foundation_custom_class | escape }} theme-tab-panel theme-tab-panel--padding-{{ block.settings.content_padding }}"
  id="{{ block.settings.identifier | handle }}"
  role="tabpanel"
  data-foundation-visibility="{{ block.settings.foundation_visibility }}"
  data-foundation-margin-top="{{ block.settings.foundation_margin_top }}"
  data-foundation-margin-bottom="{{ block.settings.foundation_margin_bottom }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>
{% stylesheet %}.theme-tab-panel{display:flex;width:100%;flex-direction:column;gap:var(--space-4)}.theme-tab-panel--padding-small{padding:var(--space-3)}.theme-tab-panel--padding-medium{padding:var(--space-5)}.theme-tab-panel--padding-large{padding:var(--space-7)}{% endstylesheet %}
{% schema %}
{
  "name": "Tab panel",
  "tag": null,
  "blocks": [
    { "type": "group" },
    { "type": "grid" },
    { "type": "carousel" },
    { "type": "product-card" },
    { "type": "collection-card" },
    { "type": "card" },
    { "type": "heading" },
    { "type": "text" },
    { "type": "image" }
  ],
  "settings": [
    {
      "type": "text",
      "id": "identifier",
      "label": "Panel identifier",
      "default": "tab-panel"
    },
    {
      "type": "select",
      "id": "content_padding",
      "label": "Content padding",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "foundation_visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "foundation_custom_class",
      "label": "Custom class"
    },
    {
      "type": "select",
      "id": "foundation_margin_top",
      "label": "Top margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2",
          "label": "XS"
        },
        {
          "value": "4",
          "label": "Medium"
        },
        {
          "value": "6",
          "label": "Large"
        },
        {
          "value": "8",
          "label": "XL"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "foundation_margin_bottom",
      "label": "Bottom margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2",
          "label": "XS"
        },
        {
          "value": "4",
          "label": "Medium"
        },
        {
          "value": "6",
          "label": "Large"
        },
        {
          "value": "8",
          "label": "XL"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "foundation_anchor_id",
      "label": "Anchor ID"
    }
  ],
  "presets": [
    {
      "name": "Tab panel",
      "blocks": [
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}

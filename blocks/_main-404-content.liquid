<div class="section-extension section-extension--main-404" {{ block.shopify_attributes }}>
  {%- comment -%}
    404 page:
    - Ambient glowing 404 badge
    - Editorial headline and subtext
    - Explore all products primary action
  {%- endcomment -%}

  <section
    class="main-404 section {% if block.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ block.settings.color_scheme.id }}{% endif %}"
    style="--padding-top: var(--spacing-sections); --padding-bottom: var(--spacing-sections);"
  >
    <div class="page-width page-width--narrow">
      <div class="error-404">
        <div class="error-404__badge-wrap" aria-hidden="true">
          <span class="error-404__badge">404</span>
          <div class="error-404__glow"></div>
        </div>

        {% content_for 'blocks' %}
        {%- if block.blocks.size == 0 -%}
          <h1 class="error-404__title h1">{{ 'general.404.title' | t }}</h1>
          <p class="error-404__text">{{ 'general.404.subtext' | t }}</p>
          <div class="error-404__actions">
            <a
              href="{{ routes.all_products_collection_url }}"
              class="button button--primary error-404__btn"
            >
              {% render 'icon', name: 'bag-plus' %}
              <span>{{ 'general.404.link' | t }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <script>
      (function () {
        try {
          var path = window.location.pathname.replace(/\/+$/, '');
          var virtualRoutes = {
            '/pages/faq': 'faq',
            '/pages/faqs': 'faq',
            '/pages/shipping': 'shipping',
            '/pages/shipping-info': 'shipping',
            '/pages/about': 'about',
            '/pages/about-us': 'about',
            '/pages/size-guide': 'size-guide',
          };
          var view = virtualRoutes[path];
          if (view) {
            var root =
              window.Shopify && window.Shopify.routes && window.Shopify.routes.root
                ? window.Shopify.routes.root
                : '/';
            var fallbackUrl = root + 'pages/contact?view=' + view;
            var main = document.getElementById('MainContent');
            if (main) main.style.opacity = '0';
            fetch(fallbackUrl)
              .then(function (res) {
                if (!res.ok) throw new Error('Failed to load page');
                return res.text();
              })
              .then(function (html) {
                var doc = new DOMParser().parseFromString(html, 'text/html');
                var newMain = doc.querySelector('#MainContent');
                if (newMain && main) {
                  main.innerHTML = newMain.innerHTML;
                  main.style.opacity = '1';
                  if (doc.title) document.title = doc.title;
                } else if (main) {
                  main.style.opacity = '1';
                }
              })
              .catch(function () {
                if (main) main.style.opacity = '1';
              });
          }
        } catch (e) {
          console.debug('Virtual route load bypassed', e);
        }
      })();
    </script>
  </section>
</div>

{% schema %}
{
  "name": "Main 404 content",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "text" },
    { "type": "button" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    },
    {
      "type": "header",
      "content": "t:common.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:common.padding.top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:common.padding.bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Main 404 content",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Lost in space? Page not found.",
            "level": "h1",
            "size": "large",
            "alignment": "center"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>",
            "alignment": "center",
            "color_role": "muted"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Explore all products",
            "link": "/collections/all",
            "style": "primary"
          }
        }
      ]
    }
  ]
}
{% endschema %}

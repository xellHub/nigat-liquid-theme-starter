{% if block.settings.foundation_anchor_id != blank -%}
  <span
    id="{{ block.settings.foundation_anchor_id | handle }}"
    class="foundation-block-anchor"
    aria-hidden="true"
  ></span>
{%- endif %}
<a
  class="{{ block.settings.foundation_custom_class | escape }} theme-link theme-link--{{ block.settings.underline }}"
  href="{{ block.settings.link | default: '#' }}"
  data-foundation-visibility="{{ block.settings.foundation_visibility }}"
  data-foundation-margin-top="{{ block.settings.foundation_margin_top }}"
  data-foundation-margin-bottom="{{ block.settings.foundation_margin_bottom }}"
  {{ block.shopify_attributes }}
  ><span>{{ block.settings.label | escape }}</span>
  {%- if block.settings.icon != 'none' %}{% render 'icon', name: block.settings.icon %}{% endif -%}
</a>
{% stylesheet %}
  .theme-link {
    display: inline-flex;
    width: fit-content;
    min-height: var(--foundation-minimum-target-size);
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-family: var(--font-body-family);
    font-weight: var(--font-button-weight);
    text-underline-offset: 0.2em;
  }
  .theme-link--none {
    text-decoration: none;
  }
  .theme-link--hover {
    text-decoration: none;
  }
  .theme-link--hover:hover {
    text-decoration: underline;
  }
  .theme-link .icon {
    width: 1em;
    height: 1em;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Link",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "arrow-right",
          "label": "Arrow right"
        },
        {
          "value": "arrow-left",
          "label": "Arrow left"
        }
      ],
      "default": "arrow-right"
    },
    {
      "type": "select",
      "id": "underline",
      "label": "Underline",
      "options": [
        { "value": "always", "label": "Always" },
        { "value": "hover", "label": "On hover" },
        { "value": "none", "label": "None" }
      ],
      "default": "always"
    },
    {
      "type": "select",
      "id": "foundation_visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "foundation_custom_class",
      "label": "Custom class"
    },
    {
      "type": "select",
      "id": "foundation_margin_top",
      "label": "Top margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2",
          "label": "XS"
        },
        {
          "value": "4",
          "label": "Medium"
        },
        {
          "value": "6",
          "label": "Large"
        },
        {
          "value": "8",
          "label": "XL"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "foundation_margin_bottom",
      "label": "Bottom margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2",
          "label": "XS"
        },
        {
          "value": "4",
          "label": "Medium"
        },
        {
          "value": "6",
          "label": "Large"
        },
        {
          "value": "8",
          "label": "XL"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "foundation_anchor_id",
      "label": "Anchor ID"
    }
  ],
  "presets": [
    {
      "name": "Link"
    }
  ]
}
{% endschema %}

<div id="BlogCarousel-{{ block.id }}" class="blog-carousel" {{ block.shopify_attributes }}>
  {% if block.settings.show_navigation %}
    <div class="blog-carousel__controls">
      <button
        type="button"
        class="blog-carousel__arrow"
        data-carousel-previous
        aria-label="Previous posts"
      >
        {% render 'icon', name: 'arrow-left' %}
      </button>
      <button type="button" class="blog-carousel__arrow" data-carousel-next aria-label="Next posts">
        {% render 'icon', name: 'arrow-right' %}
      </button>
    </div>
  {% endif %}
  {% if block.settings.blog != blank and block.settings.blog.articles.size == 0 %}
    <p class="blog-carousel__source-note">{{ 'blogs.article.no_articles' | t }}</p>
  {% endif %}
  <ul class="blog-carousel__track" role="list">
    {% if block.settings.blog != blank and block.settings.blog.articles.size > 0 %}
      {% for article in block.settings.blog.articles limit: block.settings.post_limit %}
        <li class="blog-carousel__item">
          {% render 'article-card',
            article: article,
            image_ratio: block.settings.aspect_ratio,
            show_tags: false,
            show_date: block.settings.show_date,
            show_author: block.settings.show_author,
            show_reading_time: false,
            show_excerpt: block.settings.show_excerpt
          %}
        </li>
      {% endfor %}
    {% elsif block.settings.blog == blank %}
      {% for index in (1..6) %}
        <li class="blog-carousel__item">
          {% render 'article-card',
            is_placeholder: true,
            image_ratio: block.settings.aspect_ratio,
            show_tags: false,
            show_date: block.settings.show_date,
            show_author: block.settings.show_author,
            show_reading_time: false,
            show_excerpt: block.settings.show_excerpt,
            placeholder_index: index
          %}
        </li>
      {% endfor %}
    {% endif %}
  </ul>
  <div class="blog-carousel__footer">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .blog-carousel {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: var(--space-4);
  }
  .blog-carousel__source-note { margin: 0; color: var(--color-muted); font-family: var(--font-body-family); }
  .blog-carousel__controls {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-2);
  }
  .blog-carousel__arrow {
    display: grid;
    width: var(--foundation-minimum-target-size);
    height: var(--foundation-minimum-target-size);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text);
    background: transparent;
    place-items: center;
    cursor: pointer;
  }
  .blog-carousel__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .blog-carousel__arrow svg {
    width: 1.8rem;
  }
  .blog-carousel__track {
    display: flex;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0 0 var(--space-2);
    overflow-x: auto;
    list-style: none;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .blog-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .blog-carousel__item {
    min-width: 25rem;
    flex: 0 0 calc((100% - (2 * var(--grid-gap))) / 3.25);
    scroll-snap-align: start;
  }
  .article-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: var(--color-text);
  }
  .article-card__media {
    display: grid;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-media);
    background: var(--color-surface);
    place-items: center;
  }
  .article-card__media--square {
    aspect-ratio: 1;
  }
  .article-card__media--landscape {
    aspect-ratio: 4 / 3;
  }
  .article-card__media--portrait {
    aspect-ratio: 3 / 4;
  }
  .article-card__media--adapt {
    min-height: 24rem;
  }
  .article-card__media svg,
  .article-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card:hover .article-card__image {
    transform: scale(1.03);
  }
  .article-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4);
  }
  .article-card__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: var(--text-lg);
    font-weight: var(--font-heading-weight);
    line-height: var(--line-height-heading);
  }
  .article-card__title a {
    color: inherit;
    text-decoration: none;
  }
  .article-card__meta {
    display: flex;
    gap: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .article-card__excerpt {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--color-muted);
    font-size: var(--text-sm);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  @container (max-width: 749px) {
    .blog-carousel__item {
      flex-basis: 80%;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const root = document.getElementById('BlogCarousel-{{ block.id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const track = root.querySelector('.blog-carousel__track');
    const previous = root.querySelector('[data-carousel-previous]');
    const next = root.querySelector('[data-carousel-next]');
    if (!previous || !next) return;
    const update = () => {
      previous.disabled = track.scrollLeft <= 5;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 5;
    };
    const move = (direction) => {
      const item = track.querySelector('.blog-carousel__item');
      track.scrollBy({ left: direction * (item?.offsetWidth || 320), behavior: 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>

{% schema %}
{
  "name": "Blog carousel",
  "tag": null,
  "blocks": [{ "type": "button" }, { "type": "link" }, { "type": "text" }, { "type": "@app" }],
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog" },
    {
      "type": "range",
      "id": "post_limit",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Posts to show",
      "default": 6
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Media aspect ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "adapt", "label": "Adapt" }
      ],
      "default": "landscape"
    },
    { "type": "checkbox", "id": "show_date", "label": "Show date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "checkbox", "id": "show_navigation", "label": "Show navigation", "default": true }
  ],
  "presets": [{ "name": "Blog carousel" }]
}
{% endschema %}

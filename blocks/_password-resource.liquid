<div class="resource-extension resource-extension--main-password" {{ block.shopify_attributes }}>
  {%- comment -%} Storefront password page (shown when the store is password-protected). {%- endcomment -%}

  <section class="main-password section {% if block.settings.color_scheme.id == settings.palette_5_light.id %}color-global{% else %}color-{{ block.settings.color_scheme.id }}{% endif %}">
    <div class="password__inner">
      <div class="password__brand">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 360
            | image_tag:
              loading: 'eager',
              widths: '120, 240, 360',
              sizes: '180px',
              class: 'password__logo',
              alt: shop.name
          }}
        {%- else -%}
          <h1 class="password__shop-name">{{ shop.name }}</h1>
        {%- endif -%}
      </div>

      {%- if shop.password_message != blank -%}
        <div class="password__message rte">{{ shop.password_message }}</div>
      {%- endif -%}

      {% render 'password-form' %}

      <div class="password__content">
        {% content_for 'blocks' %}
      </div>

      <p class="password__powered caption">{{ powered_by_link }}</p>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Password resource",
  "tag": null,
  "blocks": [{ "type": "heading" }, { "type": "text" }, { "type": "button" }, { "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "bare-light"
    }
  ],
  "presets": [
    {
      "name": "Password resource"
    }
  ]
}
{% endschema %}

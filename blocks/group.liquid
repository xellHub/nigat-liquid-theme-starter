{% if block.settings.foundation_anchor_id != blank -%}
  <span
    id="{{ block.settings.foundation_anchor_id | handle }}"
    class="foundation-block-anchor"
    aria-hidden="true"
  ></span>
{%- endif %}
{%- liquid
  assign group_gap = 'var(--space-4)'
  case block.settings.gap
    when '2'
      assign group_gap = 'var(--space-2)'
    when '3'
      assign group_gap = 'var(--space-3)'
    when '5'
      assign group_gap = 'var(--space-5)'
    when '6'
      assign group_gap = 'var(--space-6)'
    when 'custom'
      assign group_gap = block.settings.custom_gap | append: 'px'
  endcase

  assign group_padding = '0'
  case block.settings.padding
    when '3'
      assign group_padding = 'var(--space-3)'
    when '5'
      assign group_padding = 'var(--space-5)'
    when '7'
      assign group_padding = 'var(--space-7)'
    when 'custom'
      assign group_padding = block.settings.custom_padding | append: 'px'
  endcase

  assign group_shade = 'canvas'
  assign group_border = block.settings.border
  assign group_shadow = 'none'
  if block.settings.surface == 'surface'
    assign group_shade = 'subtle'
  elsif block.settings.surface == 'raised'
    assign group_shade = 'raised'
    assign group_shadow = 'auto'
  elsif block.settings.border == 'auto'
    assign group_border = 'off'
  endif

  assign group_radius = 'var(--radius-card)'
  if block.settings.radius == 'none'
    assign group_radius = '0px'
  elsif block.settings.radius == 'custom'
    assign group_radius = block.settings.custom_radius | append: 'px'
  endif

  assign group_max_width = '100%'
  if block.settings.max_width == 'reading'
    assign group_max_width = 'var(--foundation-reading-width)'
  elsif block.settings.max_width == 'narrow'
    assign group_max_width = 'calc(var(--foundation-reading-width) * 0.75)'
  elsif block.settings.max_width == 'custom'
    assign group_max_width = block.settings.custom_max_width | append: 'px'
  endif
-%}

<div
  class="{{ block.settings.foundation_custom_class | escape }} theme-group theme-group--{{ block.settings.direction }} theme-group--align-{{ block.settings.alignment }} theme-group--justify-{{ block.settings.justify }} theme-group--wrap-{{ block.settings.wrap }} theme-surface theme-surface--{{ group_shade }} theme-surface--border-{{ group_border }} theme-surface--shadow-{{ group_shadow }}"
  style="--group-gap:{{ group_gap }};--group-max-width:{{ group_max_width }};--surface-padding:{{ group_padding }};--surface-radius:{{ group_radius }};--surface-border-width:{{ block.settings.border_width }}px;{% if block.settings.background != blank %}--surface-background:{{ block.settings.background }};{% endif %}{% if block.settings.border_color != blank %}--surface-border-color:{{ block.settings.border_color }};{% endif %}"
  data-foundation-visibility="{{ block.settings.foundation_visibility }}"
  data-foundation-margin-top="{{ block.settings.foundation_margin_top }}"
  data-foundation-margin-bottom="{{ block.settings.foundation_margin_bottom }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .theme-group {
    display: flex;
    width: min(100%, var(--group-max-width, 100%));
    gap: var(--group-gap, var(--space-4));
  }
  .theme-group--column {
    flex-direction: column;
  }
  .theme-group--row {
    flex-direction: row;
  }
  .theme-group--align-start {
    align-items: flex-start;
    text-align: left;
  }
  .theme-group--align-center {
    align-items: center;
    text-align: center;
  }
  .theme-group--align-end {
    align-items: flex-end;
    text-align: right;
  }
  .theme-group--align-stretch {
    align-items: stretch;
  }
  .theme-group--align-stretch > * {
    width: 100%;
  }
  .theme-group--justify-start {
    justify-content: flex-start;
  }
  .theme-group--justify-center {
    justify-content: center;
  }
  .theme-group--justify-end {
    justify-content: flex-end;
  }
  .theme-group--justify-between {
    justify-content: space-between;
  }
  .theme-group--wrap-wrap {
    flex-wrap: wrap;
  }
  .theme-group--wrap-nowrap {
    flex-wrap: nowrap;
  }
{% endstylesheet %}


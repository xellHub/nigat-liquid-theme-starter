      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "subtle",
          "label": "Subtle (Default)"
        },
        {
          "value": "elevated",
          "label": "Elevated"
        }
      ],
      "default": "subtle"
    },
    {
      "type": "checkbox",

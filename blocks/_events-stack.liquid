      "type": "header",
      "content": "Card Surface & Border"
    },
    {
      "type": "select",
      "id": "card_surface",
      "label": "Card surface",
      "options": [
        {
          "value": "surface",
          "label": "Surface (Default)"
        },
        {
          "value": "surface_raised",
          "label": "Surface raised"
        },
        {
          "value": "background",
          "label": "Canvas / Background"
        },
        {
          "value": "transparent",
          "label": "Transparent"
        }
      ],
      "default": "surface"
    },
    {
      "type": "checkbox",
      "id": "card_border",
      "label": "Show card border",
      "default": true
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Card Elevation"
    },
    {
      "type": "select",
      "id": "card_shadow",

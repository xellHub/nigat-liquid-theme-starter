{% liquid
  assign event_year = block.settings.year | default: '2026'
  assign event_date = block.settings.date | default: '08 Oct'
  assign event_day = block.settings.day | default: 'Thursday'
  assign event_time = block.settings.time | default: '03:30 – 06:30'
  assign demo_variant = block.settings.demo_variant | default: 'pasta'
%}
<article class="events-card" role="listitem" {{ block.shopify_attributes }}>
  <div class="events-card__date-col">
    <div class="events-card__date-group">
      <div class="events-card__icon-badge" aria-hidden="true">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <rect x="3" y="4" width="18" height="18" rx="3" ry="3"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
          <text x="12" y="18" font-size="7.5" font-weight="700" stroke="none" fill="currentColor" text-anchor="middle">31</text>
        </svg>
      </div>
      <div class="events-card__date-texts">
        {% if event_year != blank %}<span class="events-card__year">{{ event_year | escape }}</span>{% endif %}
        {% if event_date != blank %}<span class="events-card__date">{{ event_date | escape }}</span>{% endif %}
        {% if event_day != blank %}<span class="events-card__day">{{ event_day | escape }}</span>{% endif %}
      </div>
    </div>
    <div class="events-card__date-divider" aria-hidden="true"></div>
    <div class="events-card__time-group">
      <div class="events-card__icon-badge" aria-hidden="true">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      {% if event_time != blank %}<span class="events-card__time">{{ event_time | escape }}</span>{% endif %}
    </div>
  </div>
  <div class="events-card__content-col">
    {% content_for 'blocks' %}
    {%- if block.blocks.size == 0 -%}
      <h3 class="events-card__title">Pasta From Scratch</h3>
      <p class="events-card__description">
        Learn how to mix, knead, roll, and shape fresh pasta by hand before enjoying your creations
        with two simple seasonal sauces.
      </p>
      <div class="events-card__cta-wrap">
        <a href="{{ routes.all_products_collection_url }}" class="events-card__cta-btn"
          ><span>VIEW EVENT</span></a
        >
      </div>
    {%- endif -%}
  </div>
  <div class="events-card__media-col">
    {% if block.settings.image != blank %}
      {{
        block.settings.image
        | image_url: width: 1000
        | image_tag:
          loading: 'lazy',
          fetchpriority: 'auto',
          sizes: '(min-width: 900px) 380px, 100vw',
          widths: '320, 480, 640, 800, 1000',
          class: 'events-card__image',
          alt: ''
      }}
    {% else %}
      {% render 'events-demo-svg', variant: demo_variant %}
    {% endif %}
  </div>
</article>
{% schema %}
{
  "name": "Event card",
  "tag": null,
  "blocks": [
    { "type": "heading" },
    { "type": "badge" },
    { "type": "text" },
    { "type": "button" },
    { "type": "link" },
    { "type": "group" },
    { "type": "spacer" },
    { "type": "divider" },
    { "type": "icon" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Date & Time"
    },
    {
      "type": "text",
      "id": "year",
      "label": "Year",
      "default": "2026"
    },
    {
      "type": "text",
      "id": "date",
      "label": "Date (e.g. 08 Oct)",
      "default": "08 Oct"
    },
    {
      "type": "text",
      "id": "day",
      "label": "Day of week (e.g. Thursday)",
      "default": "Thursday"
    },
    {
      "type": "text",
      "id": "time",
      "label": "Time (e.g. 03:30 – 06:30)",
      "default": "03:30 – 06:30"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Event image"
    },
    {
      "type": "select",
      "id": "demo_variant",
      "label": "Fallback illustration (when no image chosen)",
      "options": [
        {
          "value": "auto",
          "label": "Auto alternate"
        },
        {
          "value": "pasta",
          "label": "Pasta masterclass"
        },
        {
          "value": "supper",
          "label": "Seasonal supper"
        },
        {
          "value": "workshop",
          "label": "Ceramic workshop"
        },
        {
          "value": "tasting",
          "label": "Wine & food tasting"
        }
      ],
      "default": "auto"
    }
  ],
  "presets": [
    {
      "name": "Event card",
      "blocks": [
        {
          "type": "heading",
          "settings": {
            "text": "Pasta From Scratch",
            "level": "h3",
            "size": "medium"
          }
        },
        {
          "type": "badge",
          "settings": {
            "label": "MASTERCLASS",
            "style": "subtle"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "<p>Learn how to mix, knead, roll, and shape fresh pasta by hand before enjoying your creations with two simple seasonal sauces.</p>"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "VIEW EVENT",
            "link": "/collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}

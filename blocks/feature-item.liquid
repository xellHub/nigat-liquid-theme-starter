{% if block.settings.foundation_anchor_id != blank -%}
  <span
    id="{{ block.settings.foundation_anchor_id | handle }}"
    class="foundation-block-anchor"
    aria-hidden="true"
  ></span>
{%- endif %}
<div
  class="{{ block.settings.foundation_custom_class | escape }} theme-feature theme-feature--{{ block.settings.icon_position }} theme-feature--{{ block.settings.alignment }}"
  style="--feature-icon-size:{{ block.settings.icon_size }}px;"
  data-foundation-visibility="{{ block.settings.foundation_visibility }}"
  data-foundation-margin-top="{{ block.settings.foundation_margin_top }}"
  data-foundation-margin-bottom="{{ block.settings.foundation_margin_bottom }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .theme-feature {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
  }
  .theme-feature--center {
    align-items: center;
    text-align: center;
  }
  .theme-feature--end {
    align-items: flex-end;
    text-align: right;
  }
  .theme-feature--start .theme-icon-text {
    flex-direction: row;
  }
  .theme-feature--top .theme-icon-text {
    align-items: inherit;
    flex-direction: column;
  }
  .theme-feature .theme-icon-text__icon {
    width: var(--feature-icon-size);
    height: var(--feature-icon-size);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature item",
  "tag": null,
  "blocks": [
    {
      "type": "icon-with-text"
    },
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "top", "label": "Top" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "start", "label": "Start" },
        { "value": "center", "label": "Center" },
        { "value": "end", "label": "End" }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "foundation_visibility",
      "label": "Visibility",
      "options": [
        {
          "value": "all",
          "label": "All devices"
        },
        {
          "value": "mobile",
          "label": "Mobile only"
        },
        {
          "value": "desktop",
          "label": "Desktop only"
        }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "foundation_custom_class",
      "label": "Custom class"
    },
    {
      "type": "select",
      "id": "foundation_margin_top",
      "label": "Top margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2",
          "label": "XS"
        },
        {
          "value": "4",
          "label": "Medium"
        },
        {
          "value": "6",
          "label": "Large"
        },
        {
          "value": "8",
          "label": "XL"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "foundation_margin_bottom",
      "label": "Bottom margin",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "2",
          "label": "XS"
        },
        {
          "value": "4",
          "label": "Medium"
        },
        {
          "value": "6",
          "label": "Large"
        },
        {
          "value": "8",
          "label": "XL"
        }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "foundation_anchor_id",
      "label": "Anchor ID"
    }
  ],
  "presets": [
    {
      "name": "Feature item",
      "blocks": [
        {
          "type": "icon-with-text",
          "blocks": [
            {
              "type": "heading",
              "settings": {
                "text": "Built with intention",
                "level": "h3"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}

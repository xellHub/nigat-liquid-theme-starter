{
  "threshold": 5,
  "minLines": 8,
  "minTokens": 60,
  "reporters": ["console"],
  "ignore": [
    "**/sections/**",
    "**/node_modules/**",
    "**/.git/**",
    "**/bun.lock*",
    "**/*.json",
    "**/*.md",
    "**/*.svg",
    "**/*.min.*"
  ],
  "ignorePattern": ["(?s)\\{%\\s*schema[\\s\\S]*?endschema\\s*%\\}"],
  "format": ["liquid", "javascript", "css", "markup"],
  "formatsExts": {
    "markup": "liquid"
  }
}

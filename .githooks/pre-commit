#!/usr/bin/env bash
set -e

# nigat Git Pre-Commit Hook
# Validates Liquid, Shopify schemas, JSON integrity, and syntax before commit.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}==>${NC} Running nigat pre-commit checks..."

# 1. Check for unresolved merge conflict markers in staged files
echo "  [1/3] Checking for merge conflict markers..."
CONFLICT_FILES=$(git diff --cached --name-only 2>/dev/null | while IFS= read -r file; do
  if [ -f "$file" ] && grep -En '^(<<<<<<<|=======|>>>>>>>)' "$file" >/dev/null 2>&1; then
    echo "$file"
  fi
done)

if [ -n "$CONFLICT_FILES" ]; then
  echo -e "  ${RED}✗ Error: Unresolved merge conflict markers detected in:${NC}"
  echo "$CONFLICT_FILES"
  exit 1
fi
echo -e "  ${GREEN}✓${NC} No conflict markers found."

# 2. Validate JSON files and liquid schemas
echo "  [2/3] Validating JSON files and Liquid schema blocks..."
if command -v node >/dev/null 2>&1; then
  node scripts/validate-json.mjs
  echo -e "  ${GREEN}✓${NC} JSON and Liquid schemas validated successfully."
else
  echo -e "  ${YELLOW}⚠ Warning: Node.js is not installed. Skipping JSON schema validation.${NC}"
fi

# 3. Shopify Theme Check
echo "  [3/3] Running Shopify Theme Check..."
if command -v shopify >/dev/null 2>&1; then
  shopify theme check
  echo -e "  ${GREEN}✓${NC} Shopify theme check passed with 0 offenses."
elif command -v theme-check >/dev/null 2>&1; then
  theme-check
  echo -e "  ${GREEN}✓${NC} Theme Check passed with 0 offenses."
else
  echo -e "  ${YELLOW}⚠ Warning: Shopify CLI ('shopify') or 'theme-check' not found in PATH.${NC}"
  echo "    Install via: npm install -g @shopify/cli"
fi

echo -e "${GREEN}==> All nigat pre-commit checks passed! Proceeding with commit.${NC}\n"
